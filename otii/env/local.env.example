# Otii Learn settings for a laptop. This file is read by bash (set -a; . file),
# so ${NAME} refers to a value set above it.
# Copied to otii/env/local.env by
# otii/local/init-env.sh, which fills every "generate" value once.
# Staging and production use the same names, set in Northflank instead.

# --- Shared with otii (otii reads these same names) ---
OTII_LEARN_PUBLIC_URL=http://localhost:3100
OTII_LEARN_ORG_SLUG=otii
OTII_LEARN_KEYCLOAK_CLIENT_SECRET=generate
OTII_LEARN_WEBHOOK_SECRET=generate

# --- otii's Keycloak (the local otii stack) ---
OTII_KEYCLOAK_URL=http://localhost:8080
OTII_KEYCLOAK_REALM=otii

# --- otii on this laptop (started by otii's scripts/otii-learn/local-up.sh) ---
OTII_API_PORT=8220
OTII_WEB_PORT=5176

# --- Where LearnHouse sends finished courses (otii's backend) ---
OTII_LEARN_WEBHOOK_URL=http://localhost:${OTII_API_PORT}/v2/api/learn/webhooks/learnhouse
OTII_TRUSTED_WEBHOOK_HOSTS=localhost

# --- Which otii pages may show Otii Learn inside them ---
OTII_LEARN_FRAME_ANCESTORS=http://localhost:${OTII_WEB_PORT}

# --- Look: otii's theme, colour, font and logo (setup step branding) ---
OTII_LEARN_THEME=otii
OTII_LEARN_BRAND_COLOR=#1C300A
OTII_LEARN_BRAND_FONT="Baloo 2"
OTII_LEARN_BRAND_LOGO=${PWD}/otii/brand/otii-logo-orange.png

# --- LearnHouse itself ---
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://learnhouse:learnhouse@localhost:5452/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6389/0
LEARNHOUSE_AUTH_JWT_SECRET_KEY=generate
COLLAB_INTERNAL_KEY=generate
LEARNHOUSE_INITIAL_ORG_NAME=Otii
LEARNHOUSE_INITIAL_ORG_SLUG=otii
LEARNHOUSE_INITIAL_ADMIN_EMAIL=learn-admin@otii.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=generate
LEARNHOUSE_DEVELOPMENT_MODE=true
LEARNHOUSE_TENANCY=single
LEARNHOUSE_DOMAIN=localhost:3100
LEARNHOUSE_FRONTEND_DOMAIN=localhost:3100
LEARNHOUSE_SSL=false
LEARNHOUSE_EMAIL_PROVIDER=smtp
LEARNHOUSE_SMTP_HOST=localhost
LEARNHOUSE_SMTP_PORT=1025

# --- LearnHouse web ---
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:9100/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost:3100
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_HTTPS=false
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=otii
NEXT_TELEMETRY_DISABLED=1

# --- Laptop ports ---
LEARN_API_PORT=9100
LEARN_WEB_PORT=3100
LEARN_PG_PORT=5452
LEARN_REDIS_PORT=6389
